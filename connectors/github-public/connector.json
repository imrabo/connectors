{
  "schemaVersion": 1,
  "id": "github-public",
  "name": "GitHub Public Search",
  "description": "Keyless, read-only search of public GitHub repositories and issues using GitHub REST API anonymous access. Strict unauthenticated rate limits apply; use the authenticated GitHub connector for higher limits or private resources.",
  "version": "1.0.0",
  "type": "api",
  "connection": {
    "baseUrl": "https://api.github.com"
  },
  "auth": {
    "type": "none"
  },
  "tools": [
    {
      "name": "search_repositories",
      "description": "Search public GitHub repositories by name, description, README text or GitHub search qualifiers.",
      "method": "GET",
      "path": "/search/repositories",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "ImRabo/1.0"
      },
      "queryParams": {
        "q": "{{input.query}}",
        "per_page": 10
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "GitHub repository search query.",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_issues",
      "description": "Search public GitHub issues and pull requests by query. Private repository content is not accessible anonymously.",
      "method": "GET",
      "path": "/search/issues",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "ImRabo/1.0"
      },
      "queryParams": {
        "q": "{{input.query}}",
        "per_page": 10
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "GitHub issue search query.",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    }
  ]
}
